---
import "../styles/global.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import BrandMark from "../components/marketing/BrandMark.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Sube tus nóminas en PDF y entiende al instante tu salario, tus retenciones y tus finanzas." } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalUrl = new URL(currentPath, Astro.site);
const ogImageUrl = new URL("/logo-mark.png", Astro.site);

const navLinks = [
  { href: "/caracteristicas", label: "Características" },
  { href: "/precios", label: "Precios" },
  { href: "/#faq", label: "FAQ" },
];

const footerColumns = [
  {
    title: "Producto",
    links: [
      { href: "/caracteristicas", label: "Características" },
      { href: "/precios", label: "Precios" },
      { href: "/#faq", label: "Preguntas frecuentes" },
    ],
  },
  {
    title: "Cuenta",
    links: [
      { href: "/login", label: "Iniciar sesión" },
      { href: "/login", label: "Empezar gratis" },
    ],
  },
  {
    title: "Legal",
    links: [
      { href: "/privacidad", label: "Privacidad" },
      { href: "/aviso-legal", label: "Aviso legal" },
      { href: "/cookies", label: "Cookies" },
    ],
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title} · SueldIA</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2e3a48" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="SueldIA" />
    <script is:inline>
      // Service worker mínimo (solo página sin conexión): ver public/sw.js.
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function () {});
        });
      }
    </script>

    <!-- Open Graph / Twitter Card — el mismo logo-mark.png hace de og:image
         hasta que haya una imagen 1200×630 dedicada. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SueldIA" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={`${title} · SueldIA`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} · SueldIA`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        try {
          var stored = localStorage.getItem("theme");
          var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          root.classList.toggle("dark", dark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="mk-root min-h-screen text-foreground">
    <header
      id="mk-header"
      class="sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,box-shadow] duration-300"
    >
      <div class="max-w-6xl mx-auto px-5 md:px-8 h-16 flex items-center justify-between gap-4">
        <a href="/" class="shrink-0" aria-label="SueldIA, inicio">
          <BrandMark />
        </a>

        <nav class="hidden md:flex items-center gap-0.5 text-sm" aria-label="Principal">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "px-3.5 py-2 rounded-full transition-colors",
                currentPath === link.href
                  ? "text-foreground bg-foreground/[0.05]"
                  : "text-muted-foreground hover:text-foreground",
              ]}
            >
              {link.label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-1.5">
          <a href="/login" class="hidden sm:inline-flex h-9 items-center px-3.5 rounded-full text-sm text-muted-foreground hover:text-foreground transition-colors">
            Iniciar sesión
          </a>
          <a href="/login" class="mk-btn mk-btn-primary h-9 px-4 text-sm rounded-full">
            Empezar gratis
          </a>
          <button
            type="button"
            id="mk-menu-toggle"
            class="md:hidden inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-foreground/[0.05] hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            aria-expanded="false"
            aria-controls="mk-mobile-menu"
            aria-label="Abrir menú"
          >
            <svg id="mk-icon-menu" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 12h16" /><path d="M4 6h16" /><path d="M4 18h16" />
            </svg>
            <svg id="mk-icon-close" class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6 6 18" /><path d="m6 6 12 12" />
            </svg>
          </button>
        </div>
      </div>

      <div id="mk-mobile-menu" class="mk-mobile-panel md:hidden" inert>
        <nav class="max-w-6xl mx-auto px-5 py-3 flex flex-col gap-1" aria-label="Principal, móvil">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "px-3.5 py-2.5 rounded-xl text-[15px] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2",
                currentPath === link.href
                  ? "text-foreground bg-foreground/[0.05]"
                  : "text-muted-foreground hover:text-foreground hover:bg-foreground/[0.04]",
              ]}
            >
              {link.label}
            </a>
          ))}
          <div class="my-2 border-t border-border/70" role="separator"></div>
          <a href="/login" class="px-3.5 py-2.5 rounded-xl text-[15px] text-muted-foreground hover:text-foreground hover:bg-foreground/[0.04] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
            Iniciar sesión
          </a>
          <a href="/login" class="mk-btn mk-btn-primary h-10 px-4 text-sm rounded-full justify-center mt-1">
            Empezar gratis
          </a>
        </nav>
      </div>
    </header>

    <main class="-mt-16">
      <slot />
    </main>

    <footer class="relative border-t border-border/70">
      <div class="max-w-6xl mx-auto px-5 md:px-8 pt-16 pb-10">
        <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
          <div>
            <a href="/" aria-label="SueldIA, inicio">
              <BrandMark size="sm" />
            </a>
            <p class="mt-4 max-w-xs text-sm text-muted-foreground leading-relaxed">
              Tus nóminas y tus finanzas personales, explicadas con claridad.
            </p>
          </div>
          {footerColumns.map((col) => (
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.12em] text-muted-foreground/80">{col.title}</p>
              <ul class="mt-4 space-y-2.5">
                {col.links.map((link) => (
                  <li>
                    <a href={link.href} class="text-sm text-muted-foreground hover:text-foreground transition-colors">{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="mt-14 pt-6 border-t border-border/70 flex flex-col sm:flex-row gap-3 sm:items-center justify-between text-xs text-muted-foreground">
          <p>© {new Date().getFullYear()} SueldIA</p>
          <p>Pensado para nóminas españolas.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var header = document.getElementById("mk-header");
        var onScroll = function () {
          header.toggleAttribute("data-scrolled", window.scrollY > 8);
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });

        var items = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window)) {
          items.forEach(function (el) { el.classList.add("is-visible"); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
        items.forEach(function (el) { io.observe(el); });
      })();
    </script>

    <script is:inline>
      (function () {
        var header = document.getElementById("mk-header");
        var toggle = document.getElementById("mk-menu-toggle");
        var panel = document.getElementById("mk-mobile-menu");
        var iconMenu = document.getElementById("mk-icon-menu");
        var iconClose = document.getElementById("mk-icon-close");
        if (!header || !toggle || !panel) return;

        function setOpen(open) {
          header.toggleAttribute("data-menu-open", open);
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
          toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
          panel.toggleAttribute("inert", !open);
          if (iconMenu && iconClose) {
            iconMenu.classList.toggle("hidden", open);
            iconClose.classList.toggle("hidden", !open);
          }
        }

        toggle.addEventListener("click", function () {
          setOpen(toggle.getAttribute("aria-expanded") !== "true");
        });

        panel.querySelectorAll("a").forEach(function (link) {
          link.addEventListener("click", function () { setOpen(false); });
        });

        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
            setOpen(false);
            toggle.focus();
          }
        });

        document.addEventListener("click", function (e) {
          if (toggle.getAttribute("aria-expanded") !== "true") return;
          if (header.contains(e.target)) return;
          setOpen(false);
        });

        // Si la ventana crece hasta escritorio, no dejar el menú "abierto" de fondo.
        var mq = window.matchMedia("(min-width: 768px)");
        var onMq = function (e) { if (e.matches) setOpen(false); };
        if (mq.addEventListener) mq.addEventListener("change", onMq);
        else if (mq.addListener) mq.addListener(onMq);
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Cabecera: translúcida y con borde solo al hacer scroll */
  #mk-header[data-scrolled] {
    background: rgb(250 249 246 / 0.78);
    border-color: var(--border);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
  }
  .dark #mk-header[data-scrolled] {
    background: rgb(9 9 11 / 0.72);
  }

  @layer components {
    .mk-root {
      font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
      background: #faf9f6;
      font-feature-settings: "ss01", "cv11";
    }
    .dark .mk-root {
      background: #09090b;
    }

    .font-display {
      font-family: "Instrument Serif", ui-serif, Georgia, serif;
      font-weight: 400;
      letter-spacing: -0.01em;
    }

    /* Botones de marketing */
    .mk-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-weight: 500;
      white-space: nowrap;
      transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease, color 0.15s ease;
    }
    .mk-btn:active {
      transform: translateY(1px);
    }
    .mk-btn-primary {
      background: var(--primary);
      color: var(--primary-foreground);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.18),
        0 1px 2px rgb(15 23 42 / 0.2),
        0 6px 18px -6px color-mix(in oklab, var(--primary) 70%, transparent);
    }
    .mk-btn-primary:hover {
      background: color-mix(in oklab, var(--primary) 88%, black);
    }
    .dark .mk-btn-primary {
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.3),
        0 6px 22px -6px color-mix(in oklab, var(--primary) 55%, transparent);
    }
    .dark .mk-btn-primary:hover {
      background: color-mix(in oklab, var(--primary) 85%, white);
    }
    .mk-btn-secondary {
      background: var(--card);
      color: var(--foreground);
      box-shadow: 0 0 0 1px var(--border), 0 1px 2px rgb(15 23 42 / 0.05);
    }
    .mk-btn-secondary:hover {
      background: var(--muted);
    }

    /* Fondo de puntos con desvanecido radial */
    .mk-dots {
      background-image: radial-gradient(circle at 1px 1px, color-mix(in oklab, var(--foreground) 16%, transparent) 1px, transparent 0);
      background-size: 22px 22px;
      -webkit-mask-image: radial-gradient(ellipse 65% 55% at 50% 35%, #000 30%, transparent 100%);
      mask-image: radial-gradient(ellipse 65% 55% at 50% 35%, #000 30%, transparent 100%);
    }
    .dark .mk-dots {
      background-image: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.1) 1px, transparent 0);
    }

    .mk-halo {
      background: radial-gradient(ellipse 50% 60% at 50% 0%, color-mix(in oklab, var(--primary) 14%, transparent), transparent 70%);
    }
    .dark .mk-halo {
      background: radial-gradient(ellipse 50% 60% at 50% 0%, color-mix(in oklab, var(--primary) 10%, transparent), transparent 70%);
    }

    .mk-glow {
      background: radial-gradient(
        closest-side,
        color-mix(in oklab, var(--primary) 26%, transparent),
        color-mix(in oklab, var(--primary) 7%, transparent) 55%,
        transparent
      );
      filter: blur(24px);
    }
    .dark .mk-glow {
      background: radial-gradient(
        closest-side,
        color-mix(in oklab, var(--primary) 22%, transparent),
        color-mix(in oklab, var(--primary) 6%, transparent) 55%,
        transparent
      );
    }

    /* Panel de navegación móvil: desplegable bajo la cabecera, sin
       desplazar el contenido (position: absolute) para no provocar
       layout shift ni scroll horizontal. */
    .mk-mobile-panel {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      transform-origin: top;
      border-bottom: 1px solid var(--border);
      background: rgb(250 249 246 / 0.98);
      backdrop-filter: saturate(160%) blur(14px);
      -webkit-backdrop-filter: saturate(160%) blur(14px);
      box-shadow: 0 12px 32px -12px rgb(15 23 42 / 0.14);
      opacity: 0;
      transform: translateY(-6px);
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .dark .mk-mobile-panel {
      background: rgb(9 9 11 / 0.98);
      box-shadow: 0 12px 32px -12px rgb(0 0 0 / 0.55);
    }
    #mk-header[data-menu-open] .mk-mobile-panel {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    /* Superficie de tarjeta de marketing */
    .mk-card {
      background: var(--card);
      border: 1px solid var(--border);
      box-shadow: 0 1px 2px rgb(15 23 42 / 0.04);
    }
    .dark .mk-card {
      background: #111113;
      box-shadow: none;
    }

    .mk-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted-foreground);
    }

    /* Aparición al hacer scroll (solo con JS y sin reduced-motion) */
    .js .reveal {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .js .reveal.is-visible {
      opacity: 1;
      transform: none;
    }
    .js .reveal[data-delay="1"] { transition-delay: 0.08s; }
    .js .reveal[data-delay="2"] { transition-delay: 0.16s; }
    .js .reveal[data-delay="3"] { transition-delay: 0.24s; }

    @keyframes mk-dash {
      to { stroke-dashoffset: -24; }
    }
    .mk-flow {
      stroke-dasharray: 4 8;
      animation: mk-dash 1.2s linear infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .js .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
      .mk-flow {
        animation: none;
      }
      .mk-btn {
        transition: none;
      }
      .mk-mobile-panel {
        transition: none;
      }
    }
  }
</style>
