    },
    {
      "name": "Subir nómina",
      "short_name": "Subir",
      "url": "/app/upload",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Analítica",
      "short_name": "Analítica",
      "url": "/app/finance/analytics",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
