# ─── SueldIA — Variables de entorno ───────────────────────────────
# Copia este archivo como .env y ajusta los valores según tu entorno.

# Puerto del servidor backend (solo se usa en local; Vercel ignora esto)
PORT=3001

# Entorno: development | production | test
NODE_ENV=development

# Orígenes EXTRA permitidos para CORS, separados por comas (p. ej. el frontend
# en local). El mismo origen se acepta siempre: en producción el frontend llama
# a /api en su propio dominio (rewrite de Vercel) y no hace falta ponerlo aquí.
# Cualquier otro origen queda bloqueado si no aparece en esta lista.
CORS_ORIGIN=http://localhost:4321

# Connection string de Postgres (Supabase). Usa el Transaction Pooler
# (puerto 6543), no la conexión directa — es el recomendado para entornos
# serverless. Project Settings → Database → Connection string.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# URL del proyecto de Supabase (NO la de la BBDD) — se usa para verificar los
# tokens que emite Supabase Auth. Project Settings → API → Project URL.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Secreto para autenticar la llamada diaria de Vercel Cron a
# /api/cron/evaluate-alerts (evaluación de alertas configurables). Cadena
# aleatoria de al menos 16 caracteres — Vercel la manda sola como
# `Authorization: Bearer <valor>` en cuanto esta variable existe en el
# proyecto (Project Settings → Environment Variables). Sin ella, esa ruta
# responde 503 y el cron no hace nada.
CRON_SECRET=

# Service role key de Supabase (Project Settings → API → service_role, NUNCA
# la anon key) — opcional: solo se usa al eliminar una cuenta
# (DELETE /api/auth/me) para borrar también la identidad en Supabase Auth.
# Sin ella, se borran igualmente todos los datos de la persona.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Frontend (Astro) ──────────────────────────────────────────────
# Mismo proyecto de Supabase, valores públicos (van al bundle del navegador).
# Project Settings → API → Project URL / anon public key.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=change-me
